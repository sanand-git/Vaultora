# Environment variables for Vaultora
# Copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Configuration – generate a strong random secret for production
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_use_64_random_hex_chars"
JWT_EXPIRY="8h"

# Session Configuration
SESSION_MAX_AGE_MS=28800000

# Bcrypt cost factor (12+ recommended for production)
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Account lockout after N failed attempts
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Server
PORT=3001
NODE_ENV=development

# CORS – in production, restrict to your exact frontend origin
CORS_ORIGIN=http://localhost:3000

# Personal Email Live Dispatch (SMTP Configuration)
# To deliver directly from your Gmail account to personal emails,
# create a Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Gemini API (for AI features)
GEMINI_API_KEY=
